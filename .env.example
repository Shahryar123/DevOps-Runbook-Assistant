OPENAI_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=runbook-assistant

# Model provider (default: openai). Microsoft Foundry with your az login, no key
# (OPENAI_API_KEY is still needed for moderation unless MODERATION_ENABLED=false):
# LLM_PROVIDER=foundry
# FOUNDRY_ENDPOINT=https://<your-foundry>.cognitiveservices.azure.com/

# Vector store (defaults: chroma + vector). Azure AI Search:
# VECTOR_STORE=azure_search
# RETRIEVAL_MODE=hybrid
# AZURE_SEARCH_ENDPOINT=https://<your-service>.search.windows.net
# AZURE_SEARCH_INDEX_NAME=runbooks
# AZURE_SEARCH_API_KEY=   # local testing only; without it, DefaultAzureCredential is used
